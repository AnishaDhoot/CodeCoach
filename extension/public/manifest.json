{
  "manifest_version": 3,
  "name": "CodeCoach Agent",
  "version": "0.1",
  "description": "Autonomous CodeCoach Agent overlay for LeetCode. Conceptual failure diagnostics and adaptive problem recommendation.",
  "permissions": ["storage", "scripting", "cookies", "tabs", "alarms"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "content.css"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
