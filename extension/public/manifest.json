{
  "manifest_version": 3,
  "name": "CodeCoach Agent",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "Autonomous CodeCoach Agent overlay for LeetCode. Conceptual failure diagnostics and adaptive problem recommendation.",
  "permissions": ["storage", "scripting", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CodeCoach Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codecoach-backend-hja6.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "content.css"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
